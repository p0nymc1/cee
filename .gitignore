# macOS
.DS_Store

# Local editor/tool settings (per-machine, not project config)
.claude/

# Go build artifacts
/cee
/bin/
*.test
*.out

# Plugins fetched by `cee install` are local working files, not source
/plugins/

# Captured demo output, regenerated by CI on every run
/demo-output/

# Generated by .github/site in CI
/site/

# Local screening policy is private configuration, not committed
/netwatch.json

# Stray example binaries a bare `go build ./examples/<x>/` drops in the repo root
/rule_change
/code_audit
/quickstart
/network_detection
/security_monitoring
/human_approval
/meta_scenarios
/crypto_surveillance
/local_netwatch

# Site generator binary (built into bin/ by make site)
/.github/site/ceesite
